          "mainEntity": [
            {
              "@type": "Question",
              "name": "How does Resolute Corp operate?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Resolute Corp is a diversified investment and venture-building group. It invests in and builds businesses across real estate, fashion and sports, combining financial discipline, industry expertise and hands-on operational leadership to scale brands in India and international markets."
              }
            },
            {
              "@type": "Question",
              "name": "Where does Resolute Corp operate and invest?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Resolute Corp was founded in Ahmedabad, India. Its ventures include ShareSquare in Dubai, sports franchises across India and lifestyle brands that reach global markets. This cross-border presence lets the Group pursue opportunities in both mature and developing economies."
              }
            },
            {
              "@type": "Question",
              "name": "Who leads Resolute Corp?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Resolute Corp is led by Alok Sanghi, Managing Director, a finance and economics graduate of Indiana University with expertise in operational excellence, risk management and strategic diversification. Priyanka Sanghi, founder of Hair Drama Co., leads the Group’s lifestyle portfolio and has taken the brand to international markets."
              }
            },
            {
              "@type": "Question",
              "name": "How is Resolute Corp involved in hockey and volleyball?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Through Resolute Sports, Resolute Corp owns and manages two professional teams: Delhi Toofans in the Prime Volleyball League and Hyderabad Toofans in the Hockey India League. These investments support its aim to promote sports culture, strengthen grassroots development and nurture athletic talent across India. Delhi Toofans have been award winners in every season since their 2024 debut."
              }
            },
            {
              "@type": "Question",
              "name": "What distinguishes Resolute Corp’s portfolio?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Resolute Corp invests in high-growth, high-engagement sectors (sports, lifestyle and real estate), which offers the potential for both financial returns and strong brand visibility."
              }
            },
            {
              "@type": "Question",
              "name": "How has Hair Drama Co. grown under Priyanka Sanghi’s leadership?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Hair Drama Co. has broadened its product range and entered international markets through influencer marketing, global trend forecasting and omnichannel retail, positioning itself as a premium lifestyle accessory brand."
              }
            },
            {
              "@type": "Question",
              "name": "What is ShareSquare?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "ShareSquare is a Dubai-based fractional real estate investment platform for premium UAE properties. Investors can own shares in properties, diversify their portfolios and participate in potential appreciation and rental income. Returns are not guaranteed."
              }
            },
            {
              "@type": "Question",
              "name": "Does Resolute Corp seek strategic partnerships?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. Resolute Corp actively seeks collaborations with global brands, technology providers and event organisers to widen market reach, improve operational efficiency and open new revenue streams for each portfolio company."
              }
            },
            {
              "@type": "Question",
              "name": "What is Resolute Corp’s long-term investment philosophy?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Resolute Corp’s philosophy is rooted in strategic diversification, innovation-driven growth and responsible investing. Whether developing premium urban spaces, building sports franchises or scaling fashion brands, it focuses on creating financial value while fostering community development, sustainability and brand equity across its sectors."
              }
            }
          ]
        }
      ]
